#!/usr/bin/env python3
"""List each pinned image next to its latest upstream release.

Run on the Mac before the monthly update (see UPDATING.md). Read-only: it only
reads the repo and asks GitHub/Codeberg for the latest release tags.

  bin/check-updates
"""
import json
import pathlib
import re
import sys
import urllib.request

ROOT = pathlib.Path(__file__).resolve().parent.parent

# image (without tag) -> where its releases are published
UPSTREAM = {
    "authelia/authelia": ("github", "authelia/authelia"),
    "vaultwarden/server": ("github", "dani-garcia/vaultwarden"),
    "pihole/pihole": ("github", "pi-hole/docker-pi-hole"),
    "codeberg.org/forgejo/forgejo": ("codeberg", "forgejo/forgejo"),
    "jellyfin/jellyfin": ("github", "jellyfin/jellyfin"),
    "henrygd/beszel": ("github", "henrygd/beszel"),
    "henrygd/beszel-agent": ("github", "henrygd/beszel"),
    "louislam/uptime-kuma": ("github", "louislam/uptime-kuma"),
    "caddy": ("github", "caddyserver/caddy"),
    "immich": ("github", "immich-app/immich"),
    "klutchell/unbound": ("dockerhub", "klutchell/unbound"),
}


def fetch(url):
    req = urllib.request.Request(url, headers={"User-Agent": "home-lab-check-updates"})
    with urllib.request.urlopen(req, timeout=20) as r:
        return r.read().decode()


def semver_key(tag):
    return [int(x) for x in re.findall(r"\d+", tag)]


def latest(kind, repo):
    if kind == "dockerhub":
        # No GitHub releases that match the image tags; read the registry's vX.Y.Z tags.
        data = json.loads(fetch(f"https://hub.docker.com/v2/repositories/{repo}/tags?page_size=100&name=v"))
        return max((t["name"] for t in data["results"] if re.fullmatch(r"v\d+\.\d+\.\d+", t["name"])), key=semver_key)
    if kind == "github":
        return json.loads(fetch(f"https://api.github.com/repos/{repo}/releases/latest"))["tag_name"]
    # Codeberg lists newest first, including older maintenance lines; take the highest.
    tags = [r["tag_name"] for r in json.loads(fetch(f"https://codeberg.org/api/v1/repos/{repo}/releases?limit=20"))
            if not r.get("prerelease")]
    return max(tags, key=semver_key)


def release_url(kind, repo, tag):
    if kind == "dockerhub":
        return f"https://hub.docker.com/r/{repo}/tags"
    host = "github.com" if kind == "github" else "codeberg.org"
    return f"https://{host}/{repo}/releases/tag/{tag}"


def pins():
    """Yield (stack, image, tag) for every pinned image in the repo."""
    for f in sorted(ROOT.glob("stacks/*/compose.yml")) + sorted(ROOT.glob("stacks/*/Dockerfile")):
        for m in re.finditer(r"^\s*(?:image:|FROM)\s+(\S+)", f.read_text(), re.M):
            ref = m.group(1)
            if "@sha256:" in ref:
                continue  # Immich's valkey/postgres: checked by immich_drift()
            if "${IMMICH_VERSION" in ref:
                continue  # handled once below
            name, _, tag = ref.rpartition(":")
            yield f.parent.name, name, tag.replace("-builder", "")
    # On the server the real pin is in .env; in the repo only .env.example exists.
    env_file = ROOT / "stacks/immich/.env"
    env = (env_file if env_file.exists() else ROOT / "stacks/immich/.env.example").read_text()
    yield "immich", "immich", re.search(r"^IMMICH_VERSION=(\S+)", env, re.M).group(1)


def status(pinned, newest):
    p, n = pinned.lstrip("v"), newest.lstrip("v")
    if n == p or n.startswith(p + "."):
        # A floating tag like "4.39" already receives this release on `docker compose pull`.
        return "ok" if n == p else "ok (patch via pull)"
    return "UPDATE AVAILABLE"


def immich_drift():
    """Immich pins valkey/postgres by digest; flag when the official compose moved on."""
    ours = (ROOT / "stacks/immich/compose.yml").read_text()
    theirs = fetch("https://github.com/immich-app/immich/releases/latest/download/docker-compose.yml")
    want = set(re.findall(r"image:\s*(\S+@sha256:\S+)", theirs))
    have = set(re.findall(r"image:\s*(\S+@sha256:\S+)", ours))
    return sorted(want - have)


def main():
    seen, rows, failed = set(), [], False
    for stack, image, tag in pins():
        if (image, tag) in seen:
            continue
        seen.add((image, tag))
        kind, repo = UPSTREAM.get(image, (None, None))
        if not kind:
            rows.append((stack, image, tag, "?", "no upstream mapping in bin/check-updates", ""))
            continue
        try:
            newest = latest(kind, repo)
        except Exception as e:  # network/rate limit: report, keep going
            failed = True
            rows.append((stack, image, tag, "?", f"lookup failed: {e}", ""))
            continue
        st = status(tag, newest)
        rows.append((stack, image, tag, newest, st, release_url(kind, repo, newest) if st.startswith("UPDATE") else ""))

    w = [max(len(r[i]) for r in rows) for i in range(4)]
    for r in rows:
        print(f"{r[0]:<{w[0]}}  {r[1]:<{w[1]}}  {r[2]:<{w[2]}}  {r[3]:<{w[3]}}  {r[4]}")
        if r[5]:
            print(f"{'':<{w[0]}}  release notes: {r[5]}")

    try:
        drift = immich_drift()
    except Exception as e:
        failed = True
        print(f"\nimmich compose check failed: {e}")
    else:
        if drift:
            print("\nImmich's official compose now uses images we don't (update stacks/immich/compose.yml):")
            for d in drift:
                print(f"  {d}")
        else:
            print("\nImmich valkey/postgres pins match the latest official compose.")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
