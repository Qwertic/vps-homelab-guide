# Install as /etc/restic/restic.env (root:root, 600).
# The repo MUST live at a different company than the VPS (here: Backblaze B2).
RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/YOUR-BUCKET/homelab
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Keep a copy of this password offline too. Without it, the backups are unreadable.
RESTIC_PASSWORD_FILE=/etc/restic/password
# Optional: https://healthchecks.io ping URL, which alerts you if a backup fails OR never runs
HC_PING_URL=
