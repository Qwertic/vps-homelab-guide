{
	email {$ACME_EMAIL}
	acme_dns cloudflare {$CLOUDFLARE_API_TOKEN}
}

# `import authelia` in a site block puts it behind single sign-on.
(authelia) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}
}

auth.{$DOMAIN} {
	reverse_proxy authelia:9091
}

status.{$DOMAIN} {
	import authelia
	reverse_proxy uptime-kuma:3001
}

stats.{$DOMAIN} {
	import authelia
	reverse_proxy beszel:8090
}

dns.{$DOMAIN} {
	import authelia
	redir / /admin/
	reverse_proxy pihole:80
}

# The services below skip Authelia: their apps and clients (Bitwarden, git,
# Jellyfin TV, Immich mobile) can't do forward-auth. They have their own logins
# and are only reachable over Tailscale.
vault.{$DOMAIN} {
	reverse_proxy vaultwarden:80
}

git.{$DOMAIN} {
	reverse_proxy forgejo:3000
}

media.{$DOMAIN} {
	reverse_proxy jellyfin:8096
}

photos.{$DOMAIN} {
	reverse_proxy immich-server:2283
}
