# Photos and videos: on the Storage Box mount
UPLOAD_LOCATION=/srv/data/immich
# Postgres: local SSD only, never a network share
DB_DATA_LOCATION=/srv/state/immich/postgres
TZ=Etc/UTC
IMMICH_VERSION=v3.3.3
# A-Za-z0-9 only:  openssl rand -hex 24
DB_PASSWORD=
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
